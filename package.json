{
  "name": "centralprocure",
  "private": true,
  "version": "0.0.0",
  "description": "CentralProcure TypeScript monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @centralprocure/frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build -w @centralprocure/frontend",
    "dev:web": "npm run dev -w @centralprocure/frontend",
    "build:api": "npm run build -w @centralprocure/api",
    "dev:api": "npm run dev -w @centralprocure/api",
    "start:api": "npm run start -w @centralprocure/api"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  }
}
