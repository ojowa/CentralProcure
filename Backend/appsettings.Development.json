{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Primary": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "nis-eproc-identity",
    "Audience": "nis-eproc-clients",
    "DurationInMinutes": 1440
  },
  "DataProtection": {
    "KeysPath": ".data-protection-keys",
    "ApplicationName": "CentralProcure"
  },
  "InternalSession": {
    "IdleTimeoutMinutes": 15,
    "ActivityCookieName": "internalSessionActivity"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "Server": {
    "Urls": "http://localhost:5000"
  },
  "AllowedHosts": "*"
}
